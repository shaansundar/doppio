{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doppio.local/schema/scp/v1/manifest.schema.json",
  "title": "doppio Spatial Context Pack manifest",
  "type": "object",
  "required": ["schema", "pack_id", "created_at", "doppio_version", "preset", "license_policy",
               "commercial_use_ok", "input", "models", "stages", "artifacts", "warnings"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "doppio.manifest/v1"},
    "pack_id": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "doppio_version": {"type": "string", "minLength": 1},
    "preset": {"enum": ["fast", "standard", "full"]},
    "license_policy": {"enum": ["commercial", "any"]},
    "commercial_use_ok": {"type": "boolean", "description": "True only if every contributing model permits commercial use."},
    "input": {
      "type": "object",
      "required": ["sha256", "original_width", "original_height", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "filename": {"type": "string"},
        "format": {"type": "string"},
        "original_width": {"type": "integer", "minimum": 1},
        "original_height": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task", "license"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "hf_repo": {"type": "string"},
          "revision": {"type": "string"},
          "license": {
            "type": "object",
            "required": ["id", "commercial"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "commercial": {"type": "boolean"},
              "gated": {"type": "boolean"},
              "url": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "key", "cached", "elapsed_seconds"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "key": {"$ref": "#/$defs/sha256"},
          "cached": {"type": "boolean"},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "model_id": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "media_type", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_.-]+)*\\.[a-z0-9]+$"},
          "media_type": {"type": "string", "minLength": 1},
          "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "dtype": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0},
          "description": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
